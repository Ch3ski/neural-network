#!/bin/bash
# Runs clang-format on every staged C/C++ file before each commit.
set -euo pipefail

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format not found, skipping formatting" >&2
    exit 0
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hpp' '*.hxx')

if [ -z "$files" ]; then
    exit 0
fi

echo "$files" | xargs clang-format -i

echo "$files" | xargs git add
